NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
PUBLIC_APP_URL=http://127.0.0.1:3000
WEB_DIR=public
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
CORS_ORIGINS=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required for trusted server-side work such as company-scoped repositories.
# Keep this secret and never expose it to browser clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs authorized to use company functionality.
TELEGRAM_AUTHORIZED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
# polling | webhook | disabled
TELEGRAM_MODE=disabled

# Optional integration credentials. Leave blank until a real connection is configured.
GITHUB_TOKEN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ZAPIER_WEBHOOK_URL=
DOCKER_SANDBOX_URL=
DOCKER_SANDBOX_TOKEN=

# AI providers. The server only uses credentials from environment variables.
OPENAI_API_KEY=
# Optional. Use for an OpenAI-compatible gateway; defaults to https://api.openai.com/v1.
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
MANUS_API_KEY=
