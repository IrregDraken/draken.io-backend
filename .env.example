# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required for trusted server-side work such as Telegram-to-company authorization.
# Keep this secret and never expose it to browser clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs authorized to use company functionality.
TELEGRAM_AUTHORIZED_USER_IDS=
# Optional: required header value for production webhook requests.
TELEGRAM_WEBHOOK_SECRET=
# Optional: public HTTPS URL for production webhooks.
TELEGRAM_WEBHOOK_URL=
# polling | webhook | disabled
TELEGRAM_MODE=polling

# Optional integration credentials. Leave blank until a real connection is configured.
GITHUB_TOKEN=
RESEND_API_KEY=
ZAPIER_WEBHOOK_URL=
DOCKER_SANDBOX_URL=

# Optional AI provider credentials. Provider adapters remain unavailable until configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
MANUS_API_KEY=
